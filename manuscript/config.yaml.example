# ELEKTRA Configuration (example) — copy to config.yaml and edit.
# Reference copy of the live manuscript/config.yaml: paper identity,
# publication metadata, and the deterministic experiment block that drives the
# domain models. Kept byte-identical below the header by
# tests/test_manuscript_variables.py so the example cannot go stale.

paper:
  title: "The World Is Not Enough: ELEKTRA — Special-Agent Mission Software"
  subtitle: "Six Deterministic Pillars — Oil-Pipeline Choke-Point Security, Cascading-Blackout Energy Infrastructure, Nuclear-Submarine Evasion and Kalman Tracking, Hostage-Psychology Influence, and Bargaining Under Syndrome-Driven Patience"
  version: "0.1.0"
  date: "2026-08-04"

authors:
  - name: "Daniel Ari Friedman"
    orcid: "0000-0001-6232-9096"
    email: "daniel@activeinference.institute"
    affiliation: "Active Inference Institute"
    corresponding: true

publication:
  journal: "BOND Mission Software Series"
  year: "2026"

keywords:
  - "oil-pipeline security"
  - "max-flow / min-cut"
  - "choke-point analysis"
  - "passive sonar equation"
  - "evasion routing"
  - "Dijkstra"
  - "hostage psychology"
  - "Stockholm syndrome"
  - "ODE modeling"
  - "DC power flow"
  - "cascading failure"
  - "blackout modeling"
  - "Rubinstein bargaining"
  - "hostage negotiation"
  - "Kalman filter"
  - "sensor fusion"
  - "deterministic simulation"

metadata:
  license: "MIT"
  language: "en"
  mission:
    film: "The World Is Not Enough (1999)"
    codename: "ELEKTRA"

# Deterministic experiment block — the single source of mission parameters.
# The values mirror the mission adapter constants (src/.../mission.py) so the
# manuscript, the figures, and the MissionProvider all measure the same run.
experiment:
  seed: 1999
  pipeline:
    tamper_events: 40
    detection_probability: 0.85
  submarine:
    grid_size: 16
    step_m: 3000.0
    start: [1, 1]
    goal: [14, 14]
    sensors:
      - {x: 8, y: 3, source_level: 125.0, noise_level: 78.0, absorption_db_per_km: 0.5, detection_threshold_db: 15.0}
      - {x: 3, y: 9, source_level: 125.0, noise_level: 78.0, absorption_db_per_km: 0.5, detection_threshold_db: 15.0}
      - {x: 12, y: 12, source_level: 125.0, noise_level: 78.0, absorption_db_per_km: 0.5, detection_threshold_db: 15.0}
  hostage:
    days: 30.0
    dt: 0.25
    onset_threshold: 0.5
    # Initial (fear, gratitude, identification) state of the ODE system.
    initial_state: [0.7, 0.0, 0.02]
    # The nine ODE rate constants. These are the modelling assumption the
    # manuscript declares (the clinical literature is qualitative); they live
    # here so an auditor can change one and re-derive every reported number.
    dynamics:
      fear_decay: 0.12          # a      : fear self-decay
      threat_sensitivity: 0.30  # b      : threat -> fear
      kindness_gain: 0.65       # c      : kindness -> gratitude
      gratitude_decay: 0.05     # d      : gratitude decay
      ident_gain: 0.50          # e      : gratitude -> identification
      fear_suppress: 0.15       # f      : fear suppresses identification
      threat_initial: 0.75      # T0     : captivity threat at t=0
      threat_decay: 0.18        # lambda : threat decay rate
      threat_floor: 0.12        #          residual threat floor
    # The "small kindness" impulse train driving gratitude.
    kindness_events:
      - {day: 2.0, magnitude: 0.7}
      - {day: 5.0, magnitude: 0.6}
      - {day: 9.0, magnitude: 0.5}
      - {day: 14.0, magnitude: 0.4}
  power_grid:
    initial_outage: "3->5"
    overload_factor: 1.0
  negotiation:
    deadline_days: 10.0
    negotiator_discount: 0.90
    concession_rate: 0.08
    # Syndrome -> captor patience map (d_c = base + gain * S) and the opening
    # positions of the concession schedule.
    captor_discount_base: 0.55
    captor_discount_gain: 0.45
    initial_demand: 0.95
    initial_offer: 0.05
  fusion:
    dt: 1.0
    steps: 20
    process_noise: 0.1
    measurement_noise: 2.0
    seed: 1999
